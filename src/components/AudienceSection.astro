---
import businessIcon from "../assets/icons/briefcase.png";
import shieldIcon from "../assets/icons/shield.png";
import mountainIcon from "../assets/icons/mountain.png";
import schoolIcon from "../assets/icons/graduation-cap.png";
import medicalIcon from "../assets/icons/medical.png";
---

<section class="audience">
  <div class="section-inner">

    <div class="section-heading">
      <p>Who We Train</p>
      <h2>Training for the People Who Step Up</h2>
    </div>

    <div class="audience-grid">

      <article class="audience-card">
        <img
          src={businessIcon.src}
          alt=""
          class="audience-icon"
        />

        <h3>Businesses</h3>

        <p>
          Prepare employees to respond confidently to workplace emergencies.
        </p>
      </article>

      <article class="audience-card">
        <img
          src={shieldIcon.src}
          alt=""
          class="audience-icon"
        />

        <h3>Response Teams</h3>

        <p>
          Practical training for teams operating on the front lines.
        </p>
      </article>

      <article class="audience-card">
        <img
          src={mountainIcon.src}
          alt=""
          class="audience-icon"
        />

        <h3>Outdoor Organizations</h3>

        <p>
          Medical preparedness for remote and austere environments.
        </p>
      </article>

      <article class="audience-card">
        <img
          src={schoolIcon.src}
          alt=""
          class="audience-icon"
        />

        <h3>Schools &amp; Programs</h3>

        <p>
          Hands-on training for students, staff, and community groups.
        </p>
      </article>

      <article class="audience-card">
        <img
          src={medicalIcon.src}
          alt=""
          class="audience-icon"
        />

        <h3>Healthcare Professionals</h3>

        <p>
          High-quality continuing education grounded in real-world practice.
        </p>
      </article>

    </div>
  </div>
</section>