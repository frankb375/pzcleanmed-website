---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<Header />

<main class="interior-page">

  <section class="interior-hero">
  
    <h1>Let's Discuss Your Training Needs</h1>

    <p>
      Whether you're looking for <strong>tactical medicine</strong>,
      <strong>American Red Cross certification</strong>,
      <strong>wilderness medicine</strong>,
      <strong>occupational health training</strong>,
      or a completely customized medical education program,
      I'd be happy to discuss your organization's goals and
      develop training tailored to your needs.
    </p>

    <div class="contact-grid">

      <div class="contact-card">
        <h3>Email</h3>
        <p>
          <a href="mailto:frank@pzcleanmed.com">
            frank@pzcleanmed.com
          </a>
        </p>
      </div>

      <div class="contact-card">
        <h3>Location</h3>
        <p>
          Lacey, Washington
          <br />
          Available throughout Washington and nationwide.
        </p>
      </div>

      <div class="contact-card">
        <h3>Response Time</h3>
        <p>
          Most inquiries receive a response within one business day.
        </p>
      </div>

    </div>

    <div class="contact-buttons">

      <a
        class="primary-button"
        href="mailto:frank@pzcleanmed.com?subject=Training%20Request"
      >
        Request Training
      </a>

      <a
        class="secondary-button"
        href="mailto:frank@pzcleanmed.com"
      >
        Contact PZ Clean
      </a>

    </div>

  </section>

</main>

<style>
  .interior-page {
    min-height: 70vh;
  }

  .interior-hero {
    padding: 110px 24px;
    color: #ffffff;
    background: #0a2236;
  }

  .interior-hero > * {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-label {
    margin-bottom: 14px;
    color: #b9cbbd;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .interior-hero h1 {
    margin-bottom: 50px;
  }

.interior-hero p:last-of-type {
  max-width: 700px;
  font-size: 1.15rem;
  line-height: 1.7;
}

  .contact-button {
    display: inline-block;
    margin-top: 28px;
    padding: 14px 22px;
    border-radius: 6px;
    background: #e97716;
    color: #ffffff;
    font-weight: 800;
  }

  .contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 70px;
}

.contact-card {
  padding: 28px;
  border-radius: 10px;
  background: rgba(255,255,255,.08);
  text-align: center;
}

.contact-card h3 {
  margin-bottom: 18px;
}

.contact-card p {
  margin: 0;
  line-height: 1.7;
}

.contact-card a {
  color: white;
  font-weight: 700;
}

.contact-buttons {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 60px;
  flex-wrap: wrap;
}
</style>